{{>layouts/header}}

{{#article}}
<table class="table">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Subject</th>
      <th scope="col">Content</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <th scope="row">{{id}}</th>
      <td>{{subject}}</td>
      <td>{{content}}</td>
    </tr>
  </tbody>
</table>
{{/article}}
<a href="/articles" class="btn btn-secondary"> Article List</a>
<a href="/articles/{{article.id}}/edit" class="btn btn-primary">Edit</a>
<a href="/articles/{{article.id}}/delete" class="btn btn-danger">Delete</a>

{{>comments/_comments}} <!-- insert comment view page -->
{{>layouts/footer}}