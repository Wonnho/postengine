{{>layouts/header}}

{{#article}}
<table class="table">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Subject</th>
      <th scope="col">Content</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <th scope="row">{{id}}</th>
      <td>{{subject}}</td>
      <td>{{content}}</td>
    </tr>
  </tbody>
</table>
{{/article}}

{{>layouts/footer}}