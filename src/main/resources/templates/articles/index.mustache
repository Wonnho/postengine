{{>layouts/header}}

<table class="table">
  <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Subject</th>
      <th scope="col">Content</th>
    </tr>
  </thead>

  <tbody>
    {{#articleList}}
    <tr>
      <th scope="row">{{id}}</th>
      <td><a href="/articles/{{id}}">{{subject}}</a></td>
      <td>{{content}}</td>
    </tr>
    {{/articleList}}
  </tbody>
</table>

<a href="/articles/new">새글작성</a>
{{>layouts/footer}}
